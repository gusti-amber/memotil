<div class="textarea bg-surface w-full h-96 overflow-y-auto">
  <% if body.blank? %>
    <p class="flex items-center justify-center h-full text-sm text-muted">プレビューする内容がありません</p>
  <% else %>
    <div class="markdown-body flex flex-col gap-2">
      <%= markdown(body) %>
    </div>
  <% end %>
</div>
