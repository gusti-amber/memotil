<!-- ポストセクション -->
<div class="flex min-w-0 flex-1 flex-col justify-between gap-4">
  <!-- ポスト投稿フォーム -->
  <% if task.doing? %>
    <%= turbo_frame_tag "post_form" do %>
      <%= render 'posts/form', task: task, post: post %>
    <% end %>
  <% end %>

  <!-- ポスト一覧 -->
  <div class="flex max-h-screen min-w-0 flex-1 flex-col justify-start overflow-y-auto overflow-x-hidden">
    <%= turbo_frame_tag "posts_list" do %>
      <%= render "posts/posts_list", show_post_actions: task.doing? %>
    <% end %>
  </div>
</div>
